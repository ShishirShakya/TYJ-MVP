{
  "dashboard": {
    "title": "VivaAI API Metrics",
    "tags": ["vivaai", "api", "performance"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vivaai_api_requests_total[1m])",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "yaxes": [
          {
            "label": "Requests/sec",
            "format": "reqps"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Response Time (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(vivaai_api_request_duration_seconds_bucket[1m]))",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "yaxes": [
          {
            "label": "Seconds",
            "format": "s"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vivaai_api_requests_total{status=~\"5..\"}[1m])",
            "legendFormat": "5xx Errors"
          },
          {
            "expr": "rate(vivaai_api_requests_total{status=~\"4..\"}[1m])",
            "legendFormat": "4xx Errors"
          }
        ],
        "yaxes": [
          {
            "label": "Errors/sec",
            "format": "reqps"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Circuit Breaker States",
        "type": "stat",
        "targets": [
          {
            "expr": "vivaai_circuit_breaker_state",
            "legendFormat": "{{breaker}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Rate Limiter Stats",
        "type": "table",
        "targets": [
          {
            "expr": "vivaai_rate_limiter_requests_total",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "API Endpoint Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(vivaai_api_request_duration_seconds_bucket[1m]))",
            "legendFormat": "{{endpoint}} p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(vivaai_api_request_duration_seconds_bucket[1m]))",
            "legendFormat": "{{endpoint}} p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(vivaai_api_request_duration_seconds_bucket[1m]))",
            "legendFormat": "{{endpoint}} p99"
          }
        ],
        "yaxes": [
          {
            "label": "Seconds",
            "format": "s"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      }
    ]
  }
}

